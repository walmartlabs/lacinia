schema {
  query: Query
}

type Account @key(fields: "acct_number") {
  acct_number: String!
  name: String!
}
type Product @key(fields: "upc") @extends {
  reviewed_by: User
  upc: String! @external
}
type Query{
  user_by_id(id: Int!): User
}
type User @key(fields: "id") {
  id: Int!
  name: String!
}
